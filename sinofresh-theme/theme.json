{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1440px"
		},
		"color": {
			"custom": true,
			"customDuotone": true,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "name": "Ink", "slug": "text-primary", "color": "#1C2B24" },
				{ "name": "Forest", "slug": "primary", "color": "#1B4D3E" },
				{ "name": "Forest (legacy accent)", "slug": "accent", "color": "#1B4D3E" },
				{ "name": "Brand Green", "slug": "brand-green", "color": "#5AB735" },
				{ "name": "Mist", "slug": "bg-light", "color": "#F3F6F4" },
				{ "name": "Paper", "slug": "card-white", "color": "#FFFFFF" },
				{ "name": "Line", "slug": "border-light", "color": "#DCE2DF" },
				{ "name": "Line Strong", "slug": "border-medium", "color": "#C7D0CB" },
				{ "name": "Muted", "slug": "text-secondary", "color": "#5F6B65" },
				{ "name": "Kiln (CTA only)", "slug": "cta", "color": "#B54E0F" },
				{ "name": "Kiln Hover", "slug": "cta-hover", "color": "#963F0B" },
				{ "name": "Forest Tint (selection)", "slug": "cta-selected-bg", "color": "#EAF1ED" }
			]
		},
		"typography": {
			"customFontSize": true,
			"customLineHeight": true,
			"fontFamilies": [
				{
					"name": "Inter",
					"slug": "heading",
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-400.woff2"]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-600.woff2"]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-700.woff2"]
						}
					]
				},
				{
					"name": "Inter",
					"slug": "body",
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
				}
			],
			"fontSizes": [
				{ "name": "Eyebrow", "slug": "eyebrow", "size": "12px" },
				{ "name": "Small", "slug": "small", "size": "13px" },
				{ "name": "Body", "slug": "body", "size": "16px" },
				{ "name": "H3", "slug": "h3", "size": "clamp(18px, 1.6vw, 20px)" },
				{ "name": "H2", "slug": "h2", "size": "clamp(26px, 3vw, 34px)" },
				{ "name": "H1", "slug": "h1", "size": "clamp(36px, 4.5vw, 56px)" }
			]
		},
		"spacing": {
			"units": ["px", "%", "rem", "vh", "vw"],
			"spacingSizes": [
				{ "name": "1 · compact (16)", "slug": "20", "size": "16px" },
				{ "name": "2 · gap (24)", "slug": "30", "size": "24px" },
				{ "name": "3 · card (32)", "slug": "40", "size": "32px" },
				{ "name": "4 · tight section (40)", "slug": "50", "size": "40px" },
				{ "name": "5 · section (48)", "slug": "60", "size": "48px" },
				{ "name": "5 · section (48, legacy 80)", "slug": "80", "size": "48px" },
				{ "name": "6 · section XL (64)", "slug": "100", "size": "64px" }
			]
		},
		"custom": {
			"radius": {
				"button": "6px",
				"card": "6px",
				"chip": "4px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--card-white)",
			"text": "var(--wp--preset--color--text-primary)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "16px",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.25"
				},
				"color": {
					"text": "var(--wp--preset--color--text-primary)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(36px, 4.5vw, 56px)",
					"fontWeight": "700",
					"lineHeight": "1.1",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--text-primary)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(26px, 3vw, 34px)",
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--text-primary)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(18px, 1.6vw, 20px)",
					"fontWeight": "600",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "var(--wp--preset--color--text-primary)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "15px",
					"fontWeight": "600",
					"lineHeight": "1.4"
				},
				"color": {
					"text": "var(--wp--preset--color--text-primary)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--text-primary)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--cta)",
					"text": "#FFFFFF"
				},
				"border": {
					"radius": "6px"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"bottom": "12px",
						"left": "24px",
						"right": "24px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "15px",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--cta-hover)",
						"text": "#FFFFFF"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--cta-hover)",
						"text": "#FFFFFF"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "20px",
					"fontWeight": "600"
				},
				"color": {
					"text": "var(--wp--preset--color--accent)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "15px",
					"fontWeight": "500"
				},
				"color": {
					"text": "#FFFFFF"
				}
			},
			"core/post-title": {
				"color": {
					"text": "var(--wp--preset--color--text-primary)"
				},
				"typography": {
					"fontSize": "clamp(36px, 4.5vw, 56px)",
					"fontWeight": "700",
					"lineHeight": "1.12"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontSize": "15px"
				}
			}
		}
	},
	"templateParts": [],
	"customTemplates": []
}
