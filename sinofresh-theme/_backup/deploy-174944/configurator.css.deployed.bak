/*
 * SINO FRESH — Dosage Form Configurator
 * Used by page-soft-chews.html (and future dosage form pages).
 * Colors come from theme.json presets. Breakpoint: 768px.
 */

/* === Outer layout: options (65%) + summary (35%) === */
.configurator {
	display: flex;
	align-items: flex-start;
	gap: 40px;
}

.configurator__options {
	flex: 0 1 65%;
	min-width: 0;
}

.configurator__summary-col {
	flex: 1 1 35%;
	min-width: 0;
}

/* === Dimension group: label left + option buttons right (wrap) ===
   The label column is a wrapper (.configurator__label) so it can carry the
   optional expert tip under the h4 without breaking the two-column rhythm. */
.configurator__group {
	display: flex;
	align-items: flex-start;
	gap: 20px;
	padding: 18px 0;
	border-bottom: 1px solid var(--wp--preset--color--border-light);
}

.configurator__group:first-child {
	padding-top: 0;
}

.configurator__label {
	flex-shrink: 0;
	width: 170px;
}

.configurator__group h4 {
	margin: 6px 0 0;
	font-size: 16px;
	font-weight: 700;
	color: var(--wp--preset--color--primary);
}

.configurator__tip {
	margin: 4px 0 0;
	font-size: 12px;
	line-height: 1.5;
	color: var(--wp--preset--color--text-secondary);
}

.configurator__items {
	display: flex;
	flex-wrap: wrap;
	gap: 8px;
}

/* === Option button: default / hover / selected ===
   44px min height + 60px min width = comfortable touch targets. */
.configurator__item {
	display: inline-block;
	min-height: 44px;
	min-width: 60px;
	box-sizing: border-box;
	padding: 8px 16px;
	background-color: var(--wp--preset--color--card-white);
	border: 1px solid var(--wp--preset--color--border-medium);
	border-radius: 6px;
	font-family: inherit;
	font-size: 14px;
	line-height: 1.4;
	color: var(--wp--preset--color--text-primary);
	cursor: pointer;
	transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
}

.configurator__item:hover {
	border-color: var(--wp--preset--color--accent);
}

.configurator__item:focus-visible {
	outline: 2px solid var(--wp--preset--color--accent);
	outline-offset: 2px;
}

.configurator__item.is-selected {
	border-color: var(--wp--preset--color--cta);
	background-color: var(--wp--preset--color--cta-selected-bg);
	color: var(--wp--preset--color--primary);
	font-weight: 600;
}

/* === Summary card: sticky on desktop === */.configurator__summary {
	position: sticky;
	top: 100px;
	padding: 24px;
	background-color: var(--wp--preset--color--card-white);
	border: 1px solid var(--wp--preset--color--border-light);
	border-radius: 8px;
	box-shadow: 0 8px 24px rgba(27, 77, 62, 0.08);
}

.configurator__summary h3 {
	margin: 0 0 12px;
	font-size: 20px;
	color: var(--wp--preset--color--primary);
}

.configurator__summary-row {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	gap: 16px;
	padding: 9px 0;
	border-bottom: 1px solid var(--wp--preset--color--border-light);
}

.configurator__summary-row:last-of-type {
	border-bottom: none;
}

.configurator__summary-label {
	flex-shrink: 0;
	font-size: 14px;
	color: var(--wp--preset--color--text-secondary);
}

.configurator__summary-value {
	font-size: 14px;
	font-weight: 700;
	color: var(--wp--preset--color--primary);
	text-align: right;
	overflow-wrap: anywhere;
}

/* === Submit button inside summary card === */
.configurator__submit {
	display: block;
	width: 100%;
	margin-top: 18px;
	padding: 14px 20px;
	background-color: var(--wp--preset--color--cta);
	border: none;
	border-radius: 6px;
	font-family: inherit;
	font-size: 15px;
	font-weight: 600;
	color: var(--wp--preset--color--card-white);
	cursor: pointer;
	transition: background-color 0.15s ease;
}

.configurator__submit:hover {
	background-color: var(--wp--preset--color--cta-hover);
}

/* === Mobile: stack, summary not sticky === */
@media (max-width: 768px) {
	.configurator {
		flex-direction: column;
		gap: 28px;
	}

	.configurator__options,
	.configurator__summary-col {
		flex: 1 1 auto;
		width: 100%;
	}

	.configurator__summary {
		position: static;
	}

	.configurator__group {
		flex-direction: column;
		gap: 10px;
	}

	.configurator__label {
		width: auto;
	}

	.configurator__group h4 {
		margin: 0;
	}
}

/* === Summary extras: progress / reset / copy / note === */
.configurator__progress {
	margin: -6px 0 10px;
	font-size: 13px;
	color: var(--wp--preset--color--text-secondary);
	font-variant-numeric: tabular-nums;
}
.configurator__actions {
	display: flex;
	gap: 8px;
	margin-top: 10px;
}
.configurator__reset {
	flex: 1;
	padding: 11px 16px;
	background-color: var(--wp--preset--color--card-white);
	border: 1px solid var(--wp--preset--color--border-medium);
	border-radius: 6px;
	font-family: inherit;
	font-size: 14px;
	font-weight: 600;
	color: var(--wp--preset--color--text-primary);
	cursor: pointer;
	transition: border-color 0.15s ease, background-color 0.15s ease;
}
.configurator__reset:hover {
	border-color: var(--wp--preset--color--accent);
	background-color: var(--wp--preset--color--bg-light);
}
.configurator__copy {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	padding: 11px 16px;
	background-color: var(--wp--preset--color--card-white);
	border: 1px solid var(--wp--preset--color--border-medium);
	border-radius: 6px;
	font-family: inherit;
	font-size: 14px;
	font-weight: 600;
	color: var(--wp--preset--color--text-primary);
	cursor: pointer;
	transition: border-color 0.15s ease, color 0.15s ease;
}
.configurator__copy::before {
	content: "";
	width: 14px;
	height: 14px;
	border: 1.6px solid currentColor;
	border-radius: 3px;
	background:
		linear-gradient(to right, transparent -2px, var(--wp--preset--color--card-white) 2px) top left / 50% 50% no-repeat,
		linear-gradient(to right, transparent -2px, var(--wp--preset--color--card-white) 2px) bottom right / 50% 50% no-repeat;
}
.configurator__copy:hover {
	border-color: var(--wp--preset--color--accent);
}
.configurator__copy.is-copied {
	border-color: var(--wp--preset--color--accent);
	color: var(--wp--preset--color--accent);
}
.configurator__note {
	margin: 12px 0 0;
	font-size: 12px;
	line-height: 1.55;
	color: var(--wp--preset--color--text-secondary);
}

/* === Mobile/tablet action bar: Submit stays reachable === */
.configurator__mobilebar {
	display: none;
}

/* === Tablet and below: stack the configurator (65/35 split is too tight
   under 1024px) and keep a Submit bar pinned to the viewport bottom while
   the visitor scrolls the options. Sticky is constrained to .configurator,
   so the bar releases before the FAQ and never covers later sections. === */
@media (max-width: 1023px) {
	.configurator {
		flex-direction: column;
		gap: 28px;
	}

	.configurator__options,
	.configurator__summary-col {
		flex: 1 1 auto;
		width: 100%;
	}

	.configurator__summary {
		position: static;
	}

	.configurator__mobilebar {
		display: block;
		position: sticky;
		bottom: 0;
		z-index: 6;
		padding: 10px 0;
		background-color: var(--wp--preset--color--card-white);
		border-top: 1px solid var(--wp--preset--color--border-light);
	}
}

@media (prefers-reduced-motion: reduce) {
	.configurator__item,
	.configurator__reset,
	.configurator__copy,
	.configurator__submit {
		transition: none;
	}
}
